# Django
DJANGO_SECRET_KEY=your-secret-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3333

# PostgreSQL (required)
PGDATABASE=territory_watch
PGUSER=postgres
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432
# Then run in PostgreSQL: sudo -u postgres psql -c "ALTER USER postgres PASSWORD 'your_password';"
# Optional: PGSSLMODE=require for remote DB

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Copernicus Data Space (Sentinel-2). Use at least one of the two options.
# Option A (recommended for download – avoids 401 DAT-ZIP-609 "Token audience not allowed"):
#   Your Data Space login (same as dataspace.copernicus.eu).
CDSE_USERNAME=your_dataspace_login_email
CDSE_PASSWORD=your_dataspace_password
# Option B: OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
#   Works for catalogue search; download may return DAT-ZIP-609 unless Option A is set.
CDSE_CLIENT_ID=your_client_id
CDSE_CLIENT_SECRET=your_client_secret

# Sentinel Hub Processing API (optional). For on-the-fly NDVI and forest logging detection.
# Create OAuth client at: https://apps.sentinel-hub.com/dashboard/#/account/settings
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret
